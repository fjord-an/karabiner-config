{
  "title": "Caps FN: caps held = layer (A/D/Tab -> F17/F19/F18), caps tapped alone = Escape, caps held alone = Caps Lock, F6 = Ctrl+B",
  "rules": [
    {
      "description": "Caps FN: caps held = layer (A/D/Tab -> F17/F19/F18), caps tapped alone = Escape, caps held alone = Caps Lock, F6 = Ctrl+B",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "caps_fn_mode",
                "value": 1
              }
            },
            {
              "key_code": "caps_lock"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "caps_fn_mode",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "f17"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "caps_fn_mode",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "d",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "f19"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "caps_fn_mode",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "f18"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "caps_fn_mode",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f6",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "b",
              "modifiers": [
                "control"
              ]
            }
          ]
        }
      ]
    }
  ]
}
